APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Copenhagen

# Vue dealer/admin panel origin (auth, payments return URLs, marketing CTAs).
# Production example: https://panel.bilskyen.dk
# If omitted, derived as panel.{APP_URL host} (local → http://localhost:5173).
VUE_PANEL_URL=http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# UI language for Blade views and API messages. Production: omit or set `da`. Local dev: `en`
# APP_LOCALE=da

APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outbound mail: use Brevo SMTP (default mailer). MAIL_FROM_* must be a sender verified in Brevo.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Brevo SMTP (preferred; falls back to MAIL_HOST / MAIL_PORT / MAIL_USERNAME / MAIL_PASSWORD if unset)
SMTP_SERVER=smtp-relay.brevo.com
PORT=587
LOGIN=null
SMTP_KEY=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Locale for rendering all outbound mailables (subjects and views). Default: da
MAIL_LOCALE=da

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
